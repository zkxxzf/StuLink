# StuLink 环境变量示例（复制为 .env 后填写；.env 不入库）
# 微信小程序（AppSecret 只放环境变量，不要写进代码/文档）
WX_MP_APPID=
WX_MP_SECRET=
# 仅本机联调：1=允许 code=mock:<openid>（生产必须为 0）
WX_MP_MOCK=0
STULINK_WX_QR_TTL=120

# H-07：密钥文件移出同步盘后，指向受控目录（显式指定但读不到会启动失败）
STULINK_SECRET_KEY_FILE=
STULINK_ENCRYPTION_KEY_FILE=
# P1 M-11：往届站独立密钥（不填则用 data/.alumni_secret_key，首次自动生成）
ALUMNI_SECRET_KEY=

# HTTPS / 反向代理（H-10）
STULINK_HTTPS=0
STULINK_TRUST_PROXY=0
STULINK_SESSION_COOKIE_SECURE=0
# L-04：可信反代 IP（逗号分隔）；只有来自这些来源才信 X-Real-IP/XFF。
# 应用端口只绑 127.0.0.1 时可填 *；直连部署保持空。
STULINK_TRUSTED_PROXIES=
# 反代后建议只监听本机
STULINK_BIND=0.0.0.0
STULINK_PORT=5000

# MCP（H-09；容器内 host 保持 0.0.0.0，宿主端口只发布 127.0.0.1）
STULINK_MCP_REQUIRE_TOKEN=true
STULINK_MCP_TOKEN=
STULINK_MCP_ALLOW_WRITE=false
STULINK_MCP_AUDIT_READS=true
# P2：MCP 认证通过后的读请求频控（0=不限制）
STULINK_MCP_READ_RATE_LIMIT=120
STULINK_MCP_READ_RATE_WINDOW=60

# P2：AI 每日配额 / 单次超时（0 配额表示不限制）
AI_DAILY_QUOTA=50
AI_REQUEST_TIMEOUT=180
# P2：单进程内同时执行的 AI 任务上限（不是持久队列，重启仍会中断）
AI_MAX_GLOBAL_TASKS=6
# P2：CSP 默认 enforcing；排障可改 report；nonce 需模板补 nonce 后再开
STULINK_CSP_MODE=enforce
STULINK_CSP_NONCE=0

# L-01：小程序通知详情 GET 默认不写已读（客户端需调 POST /notices/<id>/read）
# 兼容旧客户端可临时设为 1
WX_NOTICE_DETAIL_AUTO_READ=0
